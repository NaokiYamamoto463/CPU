// =====================================
// 画面全体を黒で消去する
// =====================================
`MM[0] = 32'h810000B7; // x1 = 画面メモリ先頭
`MM[1] = 32'h00008AB3; // x21 = 書き込み先
`MM[2] = 32'h0004BB37; // x22 = 307200画素

`MM[3] = 32'h000AA023; // 黒を書き込む
`MM[4] = 32'h004A8A93; // 次の画素へ
`MM[5] = 32'hFFFB0B13; // 残り画素数を減らす
`MM[6] = 32'hFE0B1AE3; // 残っていればMM[3]へ

// =====================================
// 描画の設定
// =====================================
`MM[7] = 32'hFFF00C13; // x24 = -1：下位12ビットは白FFF
`MM[8] = 32'h00000113; // x2 = 文字データの先頭アドレス

// 文字列全体の左上座標
`MM[9]  = {12'd216, 5'd0, 3'b000, 5'd3, 7'b0010011}; // X
`MM[10] = {12'd208, 5'd0, 3'b000, 5'd4, 7'b0010011}; // Y

`MM[11] = 32'h00000293; // x5 = 文字番号0
`MM[12] = 32'h00018333; // x6 = 現在の文字のX座標
`MM[13] = 32'h00200C93; // x25 = 拡大率2
`MM[14] = 32'h02000D13; // x26 = 32行・32列
`MM[15] = 32'h00300D93; // x27 = 3文字

// =====================================
// 文字の1行を読み出す
// =====================================
`MM[16] = 32'h00000393; // 行番号を0にする
`MM[17] = 32'h00012403; // 文字データを1行読み出す
`MM[18] = 32'h00000493; // 列番号を0にする

// 左端のビットを調べる
`MM[19] = 32'h01F45513; // bit31を取り出す
`MM[20] = 32'h04050863; // 0なら描かずMM[40]へ

// =====================================
// 描く点の画面座標を計算する
// =====================================
`MM[21] = 32'h00149593; // 列番号×2
`MM[22] = 32'h006585B3; // 文字のX座標を加える
`MM[23] = 32'h00139613; // 行番号×2
`MM[24] = 32'h00460633; // 文字列のY座標を加える

// 1つの点を2×2画素として描く
`MM[25] = 32'h00000713; // 縦方向の追加位置を0
`MM[26] = 32'h00000693; // 横方向の追加位置を0
`MM[27] = 32'h00D587B3; // 実際のX座標
`MM[28] = 32'h00E60833; // 実際のY座標

// =====================================
// アドレス = 0x81000000 + Y×2560 + X×4
// =====================================
`MM[29] = 32'h00B81893; // Y×2048
`MM[30] = 32'h00981913; // Y×512
`MM[31] = 32'h012888B3; // 合計してY×2560
`MM[32] = 32'h00279913; // X×4
`MM[33] = 32'h012888B3; // X方向の位置を加える
`MM[34] = 32'h001888B3; // 画面メモリ先頭を加える
`MM[35] = 32'h0188A023; // 白を書き込む

// 横2画素・縦2画素の繰り返し
`MM[36] = 32'h00168693;
`MM[37] = 32'hFD969CE3; // MM[27]へ
`MM[38] = 32'h00170713;
`MM[39] = 32'hFD9716E3; // MM[26]へ

// =====================================
// 次の列・行・文字へ進む
// =====================================
`MM[40] = 32'h00141413; // 文字データを左へ1ビットずらす
`MM[41] = 32'h00148493; // 次の列
`MM[42] = 32'hFBA492E3; // 32列までMM[19]へ

`MM[43] = 32'h00410113; // 次の行の文字データへ
`MM[44] = 32'h00138393; // 次の行
`MM[45] = 32'hF9A398E3; // 32行までMM[17]へ

`MM[46] = 32'h04830313; // 次の文字を72画素右へ
`MM[47] = 32'h00128293; // 次の文字
`MM[48] = 32'hF9B290E3; // 3文字までMM[16]へ

// 描画完了：ここで繰り返す
`MM[49] = 32'h00000063;