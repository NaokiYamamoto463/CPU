// 0〜100の合計をx10に求め、最後にx30へ結果5050を渡す
`MM[0] = 32'h800000B7; // lui x1,0x80000：VGAのアドレス
`MM[1] = 32'h00F00113; // addi x2,x0,15：明るさ15

// 赤・緑・青をすべて15にして白色にする
`MM[2] = 32'h0020A023; // sw x2,0(x1)：赤=15
`MM[3] = 32'h0020A223; // sw x2,4(x1)：緑=15
`MM[4] = 32'h0020A423; // sw x2,8(x1)：青=15

// ここで繰り返し、表示を維持する
`MM[5] = 32'h00000063; // beq x0,x0,0

// `MM[0] = 32'h800000B7; // lui x1,0x80000
// `MM[1] = 32'h00F00113; // addi x2,x0,15

// // ====================================
// // 赤色表示
// // ====================================
// `MM[2] = 32'h0020A023; // sw x2,0(x1) 赤=15
// `MM[3] = 32'h0000A223; // sw x0,4(x1) 緑=0
// `MM[4] = 32'h0000A423; // sw x0,8(x1) 青=0

